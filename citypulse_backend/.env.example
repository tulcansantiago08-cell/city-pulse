# Copia este archivo como .env y pon tu propia cadena de conexión de MongoDB Atlas.
# El archivo .env NO se sube a GitHub.
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/citypulse_db?retryWrites=true&w=majority

# Clave para firmar los tokens JWT (mínimo 256 bits). Genera una con:
#   openssl rand -base64 64 | tr -d "\n"
JWT_SECRET=<clave-aleatoria-en-base64>

# Primer administrador: se crea al arrancar si la base no tiene ninguno (opcional)
ADMIN_CORREO=admin@citypulse.co
ADMIN_PASSWORD=<contraseña-de-al-menos-8-caracteres>
ADMIN_NOMBRE=Santiago
ADMIN_APELLIDO=Rivas
